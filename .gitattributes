# 统一换行，避免 Windows 下 git 自动转换造成"整文件都改了"
* text=auto eol=lf

# Windows 脚本保留 CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制文件（不参与换行转换、不做 diff）
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.eext binary
*.zip  binary
*.blend binary
*.xlsx binary
*.step binary
*.dxf  binary
